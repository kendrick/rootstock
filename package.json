{
	"name": "rootstock",
	"type": "module",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@10.28.2",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "next build",
		"dev": "next dev",
		"generate": "tsx scripts/generate.ts",
		"lint": "eslint .",
		"lint:css": "stylelint \"**/*.css\" --allow-empty-input",
		"lint:css:fix": "stylelint \"**/*.css\" --fix --allow-empty-input",
		"lint:fix": "eslint . --fix",
		"prepare": "husky",
		"pretest:e2e": "next build",
		"preview": "rm -rf .preview && mkdir -p .preview && cp -R out .preview/rootstock && serve .preview --listen ${E2E_PORT:-3000} --no-clipboard",
		"schedule": "tsx scripts/schedule.ts",
		"schema": "tsx scripts/generate-schema.ts",
		"start": "next start",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@radix-ui/react-dialog": "1.1.23",
		"@radix-ui/react-separator": "1.1.15",
		"@radix-ui/react-slot": "1.3.3",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"idb": "8.0.3",
		"lucide-react": "1.45.0",
		"next": "16.3.5",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"tailwind-merge": "3.6.0",
		"zod": "4.6.2"
	},
	"devDependencies": {
		"@antfu/eslint-config": "9.3.0",
		"@axe-core/playwright": "4.13.0",
		"@dreamsicle.io/stylelint-config-tailwindcss": "1.2.2",
		"@eslint-react/eslint-plugin": "5.18.6",
		"@next/eslint-plugin-next": "16.3.3",
		"@playwright/test": "1.62.1",
		"@tailwindcss/postcss": "4.3.3",
		"@testing-library/dom": "10.4.1",
		"@testing-library/react": "16.3.3",
		"@types/node": "22.19.19",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitest/coverage-v8": "4.1.11",
		"eslint": "10.9.1",
		"eslint-plugin-format": "2.0.1",
		"eslint-plugin-jsx-a11y": "6.10.2",
		"eslint-plugin-react-refresh": "0.5.5",
		"fake-indexeddb": "6.2.5",
		"husky": "9.1.7",
		"jsdom": "30.0.1",
		"lint-staged": "17.4.1",
		"serve": "14.2.6",
		"stylelint": "17.14.1",
		"stylelint-config-standard": "40.0.0",
		"tailwindcss": "4.3.3",
		"tsx": "4.23.13",
		"typescript": "5.9.3",
		"vitest": "4.1.11"
	}
}
