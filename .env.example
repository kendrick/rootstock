# Property latitude, -90 to 90. Never a real value here: ADR 0004 keeps it in the generation environment only.
ROOTSTOCK_LATITUDE=
# Property longitude, -180 to 180. Never a real value here: ADR 0004 keeps it in the generation environment only.
ROOTSTOCK_LONGITUDE=
# IANA time zone for the property (e.g. America/Chicago), used to bucket the Planner's local days.
ROOTSTOCK_TIME_ZONE=
# Path segment the Away Card is served at. Never a real value here: ADR 0004 keeps it in the build environment only, because a committed slug is a published one.
ROOTSTOCK_AWAY_SLUG=
